# Mot de passe de l'espace admin (8 caractères minimum)
# Copier ce fichier en .env.local et remplir les valeurs.
ADMIN_PASSWORD=

# SMTP transactionnel
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Basic IT <bonjour@basic-it.fr>"

# Copie optionnelle des nouvelles réservations au studio
STUDIO_EMAIL=

# URL publique locale, utilisée par Stripe Checkout
APP_URL=https://basic-it.localhost

# Stripe, mode test uniquement
# Le script bun run dev injecte automatiquement STRIPE_WEBHOOK_SECRET
# depuis `stripe listen`. La valeur ci-dessous sert à `bun run start`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
