# SMTP transactionnel
# Copier ce fichier en .env.local et remplir les valeurs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Basic IT <bonjour@basic-it.fr>"

# Copie optionnelle des nouvelles réservations au studio
STUDIO_EMAIL=

# URL publique locale, utilisée plus tard par Stripe Checkout
APP_URL=https://basic-it.localhost

# Stripe mode test, à remplir au moment de l'intégration
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
